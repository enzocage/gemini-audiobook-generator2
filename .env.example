# =====================================================================
# Gemini Audiobook Generator - Environment Configuration
# =====================================================================
# Kopiere diese Datei zu `.env.local` oder `.env` und trage deinen Key ein:
#   cp .env.example .env.local
#
# Erhalte einen Google Gemini API-Key kostenlos oder mit Pay-As-You-Go unter:
# https://aistudio.google.com/app/apikey
# =====================================================================

# Google Gemini API Key (Erforderlich für TTS- & Bild-Generierung)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternativer Schlüsselname (Fallback)
# API_KEY=your_gemini_api_key_here
